cabal-version:      3.0
name:               pureHask
version:            0.2.0.0
synopsis:           2D Platformer in Haskell (SDL2 + Reflex + Apecs)
license:            MIT
author:             Antigravity & User
maintainer:         user@example.com
build-type:         Simple

common shared
    default-language: Haskell2010
    default-extensions:
        TemplateHaskell
        FlexibleInstances
        MultiParamTypeClasses
        TypeFamilies
        FlexibleContexts
        ScopedTypeVariables
        OverloadedStrings
        DataKinds
        TypeApplications
    ghc-options: -Wall

library
    import:           shared
    hs-source-dirs:   src
    exposed-modules:
        Core.Components
        Core.Config
        Core.Lang
        Core.Settings
        Core.Types
        Enemy.Script
        Flow.Machine
        FRP.Network
        Game.Assets
        Game.Logic
        Hud.Machine
        Input.Semantics
        Items.Registry
        Npc.Core
        Npc.Script
        Quest.Runtime
        Quest.Script
        Render.Draw
        Render.Font
        Render.Hud
        Render.Layers
        Render.Menu
        Render.UI
        Render.Widgets
        Save.Codec
        Script.Expr
        Script.Inherit
        Script.Sexp
        Sim.Combat
        Sim.CombatCore
        Sim.Damage
        Sim.Enemy
        Sim.EnemyCore
        Sim.EquipCore
        Sim.Items
        Sim.Npc
        Sim.ParticleCore
        Sim.Particles
        Sim.Physics
        Sim.Rules
        Sim.Spawn
        World.Level
        World.Scene
        World.Tilemap
    build-depends:
        base >= 4.14 && < 5,
        aeson >= 2.2,
        apecs >= 0.8,
        bytestring,
        containers,
        dependent-sum,
        directory,
        filepath,
        linear >= 1.21,
        mtl,
        reflex >= 0.8,
        sdl2 >= 2.5,
        sdl2-ttf >= 2.1,
        text,
        transformers,
        vector >= 0.12

executable pureHask
    import:           shared
    main-is:          Main.hs
    hs-source-dirs:   app
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base,
        apecs,
        containers,
        directory,
        filepath,
        linear,
        pureHask,
        sdl2,
        text,
        time

test-suite pureHask-test
    import:           shared
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    other-modules:
        CodecSpec
        CombatCoreSpec
        EnemyCoreSpec
        EquipCoreSpec
        ExprSpec
        FlowSpec
        HudSpec
        InheritSpec
        ItemsSpec
        LangSpec
        LevelSpec
        NpcSpec
        ParticleSpec
        QuestSpec
        RegistrySpec
        SceneSpec
        SemanticsSpec
        SettingsSpec
        SexpSpec
        TilemapSpec
    build-depends:
        base,
        bytestring,
        containers,
        hspec,
        linear,
        pureHask,
        text,
        vector
