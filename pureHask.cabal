cabal-version:      3.0
name:               pureHask
version:            0.1.0.0
synopsis:           2D Platformer Prototype in Haskell (SDL2 + Reflex + Apecs)
license:            MIT
author:             Antigravity & User
maintainer:         user@example.com
build-type:         Simple

executable pureHask
    main-is:          Main.hs
    other-modules:    Types
                      Map
                      Physics
                      Render
                      FRP
    hs-source-dirs:   src
    default-language: Haskell2010
    default-extensions:
        TemplateHaskell
        FlexibleInstances
        MultiParamTypeClasses
        TypeFamilies
        FlexibleContexts
        ScopedTypeVariables
        OverloadedStrings
        DataKinds
        TypeApplications
    ghc-options:
        -Wall
        -threaded
        -rtsopts
        -with-rtsopts=-N
    build-depends:
        base >= 4.14 && < 5,
        sdl2 >= 2.5,
        reflex >= 0.8,
        apecs >= 0.8,
        linear >= 1.21,
        vector >= 0.12,
        containers,
        mtl,
        transformers,
        dependent-sum
