packages:
  .

-- GHC 9.14 ships base-4.22 / template-haskell-2.24, which are newer than the
-- upper bounds declared by reflex and its dependencies. Relax those two bounds
-- globally; everything else stays solver-checked.
allow-newer:
  *:base,
  *:template-haskell,
  *:ghc-prim,
  *:deepseq,
  *:containers
