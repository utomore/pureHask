;; 長老:第一個 NPC。個性 = 移動參數 + 閒聊台詞。
;; 對話規則由上而下嘗試;第一個條件成立的規則獲勝。
;; 顯示文字以裸符號引用 assets/lang/*.lang 的 key。

(npc elder
  (name npc.elder.name)
  (color 200 180 120)
  (size 24 32)
  (spawn-at 01-training 10 13)
  (movement (patrol 8 14) (speed 35) (pause 1.5))
  (chatter 9 npc.elder.chat.1 npc.elder.chat.2)
  (dialogue
    (rule (quest-state find-key done)
      (say elder npc.elder.done.1))
    (rule (flag met-elder)
      (say elder npc.elder.hint.1 npc.elder.hint.2))
    (default
      (say elder npc.elder.hello.1 npc.elder.hello.2)
      (set-flag met-elder))))

;; 長老的回聲:用 (inherit elder) 展示 NPC 繼承——
;; 自己的規則排最前面,長老的規則全部墊底(繼承的台詞仍以長老的
;; 聲音說出,正合「迴響」);movement 逐項覆蓋;spawn-at 自己放。

(npc elder-echo
  (inherit elder)
  (name npc.elder-echo.name)
  (color 120 160 210)
  (spawn-at 05-abyssgate 44 13)
  (movement (idle))
  (chatter 13 npc.elder-echo.chat.1)
  (dialogue
    (rule (quest-state cull-slimes done)
      (say elder-echo npc.elder-echo.praise.1))))
